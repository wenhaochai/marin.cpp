// marincpp knob registry: the ONE place a configuration knob is declared (DESIGN.md §9).
//
// NM_KNOB(section, name, type, default, flags, tag, check, doc)
//   section, name  -> field `section_name` in nm::Config, key "section.name" in TOML/JSON/CLI (--set section.name=v)
//   type           -> bool | int | int64_t | double | std::string   (decimals are stored as double and rounded to f32
//                     once, where the math uses them, exactly as Python's float -> jnp.float32 does)
//   default        -> the plain Kaiyue muonh_qwen3 130m baseline (presets in src/config/presets.cpp override sizes)
//   flags          -> NM_HASH: part of the run identity; NM_LOCAL: execution-local, excluded from the hash (paths,
//                     logging, W&B names, debug modes). A knob that changes any number the run computes is NM_HASH,
//                     including execution choices that only change summation order.
//                     NM_CONTENT (with NM_HASH): a file input; resolve() appends "#sha256=<content hash>" and the identity
//                     takes only that hash, so the path spelling stays local (./x and an absolute path give one id).
//   tag            -> label fragment appended when the value differs from the default: at most one conversion, %d for
//                     int knobs, %g for double, %s for string, none for bool (checked at compile time, knobs.cpp)
//   check          -> a boolean expression over `v` (the value); cross-knob rules live in validate() (config.cpp).
//                     Knobs naming an extension check registry_has(...): names live only in register_* lines.
//                     Shape and batch ranges keep every integer product of the planner and the step budget exact.
//   doc            -> one line; `marincpp knobs` prints this table.
//
// Identity: only hashed knobs that differ from their default enter the hash, plus kKnobTableVersion (config.hpp).
// Adding a knob whose default keeps the old behaviour changes no run id. CHANGING A DEFAULT BUMPS kKnobTableVersion.

// ---------------------------------------------------------------------------------------------------- model
NM_KNOB(model, size,        std::string, "130m",     NM_LOCAL, "",          one_of(v, {"130m","300m","520m","1_2b","pls_d48","custom"}), "preset that fills the shape knobs below (label only; the resolved shape is hashed)")
NM_KNOB(model, vocab,       int,         128256,     NM_HASH,  "-v%d",      v >= 256 && v <= (1 << 24), "vocabulary size V (untied embedding and head); sort key bits = ceil(log2 V)")
NM_KNOB(model, hidden,      int,         512,        NM_HASH,  "-h%d",      v >= 64 && v <= 65536 && v % 64 == 0, "hidden width D")
NM_KNOB(model, layers,      int,         6,          NM_HASH,  "-d%d",      v >= 1 && v <= 256, "number of transformer layers L")
NM_KNOB(model, heads,       int,         8,          NM_HASH,  "",          v >= 1 && v <= 1024, "query heads H")
NM_KNOB(model, kv_heads,    int,         8,          NM_HASH,  "",          v >= 1 && v <= 1024, "key/value heads KV (GQA if KV < H; query head h reads kv head h / (H/KV))")
NM_KNOB(model, head_dim,    int,         0,          NM_HASH,  "",          v == 0 || v == 64 || v == 128, "head dim; 0 = hidden / heads")
NM_KNOB(model, mlp,         int,         1792,       NM_HASH,  "",          v >= 64 && v <= (1 << 20) && v % 64 == 0, "SwiGLU width F")
NM_KNOB(model, seq_len,     int,         4096,       NM_HASH,  "-sl%d",     v >= 128 && v <= 65536, "training window S (any value; attention has no block constraint)")
NM_KNOB(model, rope_theta,  double,      10000.0,    NM_HASH,  "",          v > 0, "RoPE base; inv_freq built in f32 as numerics.md 3.3")
NM_KNOB(model, norm_eps,    double,      1e-5,       NM_HASH,  "",          v > 0, "RMSNorm eps, inside the rsqrt")
NM_KNOB(model, block,       std::string, "sandwich", NM_HASH,  "-a%s",      registry_has(RegistryKind::Block, v), "residual design of every layer (Block registry; moda is not registered until its kernel exists)")
NM_KNOB(model, input,       std::string, "embed",    NM_HASH,  "-in%s",     registry_has(RegistryKind::Input, v), "input layer (InputLayer registry: embed, composed, ngram, ...)")
NM_KNOB(model, head,        std::string, "full",     NM_HASH,  "-hd%s",     registry_has(RegistryKind::Head, v), "output head (OutputHead registry: full, sampled, composed, ...)")
NM_KNOB(model, losses,      std::string, "",         NM_HASH,  "-aux%s",    registry_has_all(RegistryKind::Loss, v), "comma list of auxiliary loss terms (LossTerm registry)")
NM_KNOB(model, hc_streams,  int,         4,          NM_HASH,  "",          v >= 1 && v <= 8, "residual streams m for block=hc/mhc")
NM_KNOB(model, depth_route, std::string, "dynamic",  NM_HASH,  "-r%s",      one_of(v, {"dynamic","static"}), "hc/attnres routing: dynamic or static part only")
NM_KNOB(model, tie_embeddings, bool,     false,      NM_HASH,  "-tie",      true, "tie lm_head to the embedding")
NM_KNOB(model, trunk,       std::string, "train",    NM_HASH,  "-trunk%s",  one_of(v, {"train","frozen"}), "frozen: heads-only model (trunk from init.from; no trunk backward where heads do not need it)")

// ---------------------------------------------------------------------------------------------------- init
NM_KNOB(init, seed,         int,         0,          NM_HASH,  "-s%d",      v >= 0, "trainer seed; threefry2x32 key tree of model.md 4.2")
NM_KNOB(init, mode,         std::string, "threefry", NM_HASH,  "",          one_of(v, {"threefry","fixture","from"}), "threefry: port of JAX init (XLA f32 erf/erf_inv); fixture: levref init (parity runs use it until T1.1 passes bitwise); from: another run's tensors")
NM_KNOB(init, fixture,      std::string, "",         NM_HASH | NM_CONTENT, "",          true, "path of an init fixture; resolved to its sha256 in the hashed config")
NM_KNOB(init, from,         std::string, "",         NM_HASH,  "-from",     true, "<run_id>@<step> or a manifest path (init.mode=from); its hash is checked against its own manifest")
NM_KNOB(init, map,          std::string, "",         NM_HASH,  "",          true, "ordered rules 'target_regex=source|init;...' mapping tensors from init.from")
NM_KNOB(init, freeze,       std::string, "",         NM_HASH,  "-frz",      true, "regex of tensors placed in group Frozen")
NM_KNOB(init, opt_state,    std::string, "fresh",    NM_HASH,  "",          one_of(v, {"fresh","copy"}), "optimizer state of mapped tensors")

// ---------------------------------------------------------------------------------------------------- per-layer readouts (pls)
NM_KNOB(readout, kind,      std::string, "none",     NM_HASH,  "-pls%s",    one_of(v, {"none","shared","separate"}), "per-layer LM readouts: none, through the final norm+head (shared), or own norm+head per layer (separate)")
NM_KNOB(readout, table,     std::string, "",         NM_HASH | NM_CONTENT, "-rt",       true, "optional readout-table file (several readouts per layer, modes train/probe/monitor, groups); hashed by content")
NM_KNOB(readout, weight,    double,      1.0,        NM_HASH,  "-w%g",      v >= 0, "weight of every intermediate readout loss (final layer weight is 1)")
NM_KNOB(readout, shape,     std::string, "uniform",  NM_HASH,  "-sh%s",     one_of(v, {"uniform","depth"}), "intermediate weights: uniform, or weight*2(k+1)/L")
NM_KNOB(readout, detach_head, bool,      false,      NM_HASH,  "-dh",       true, "shared heads: intermediate losses train the trunk only")
NM_KNOB(readout, detach_backbone, bool,  false,      NM_HASH,  "-bbfrozen", true, "separate heads: readout losses train their heads only (dx = nullptr: no dX GEMM)")
NM_KNOB(readout, local,     bool,        false,      NM_HASH,  "-local",    true, "separate heads: each loss trains its head and its own layer only")
NM_KNOB(readout, off,       std::string, "",         NM_HASH,  "-off%s",    true, "S:E weight ramps from weight to 0 between steps S and E; after E readouts are skipped (regime)")
NM_KNOB(readout, on,        std::string, "",         NM_HASH,  "-on%s",     true, "S:E late start of the backbone gradient (regime boundary: no dX GEMM before S)")
NM_KNOB(readout, visible_frac, double,   1.0,        NM_HASH,  "-vis%g",    v > 0 && v <= 1, "intermediate readouts see the first frac of the hidden coordinates")
NM_KNOB(readout, opt_split, bool,        false,      NM_HASH,  "-os",       true, "aux heads/norms get optimizer groups (and clip norms) of their own")
NM_KNOB(readout, eval_per_layer, bool,   true,       NM_HASH,  "",          true, "evaluate every readout in the Paloma eval (eval/L{k}/...)")

// ---------------------------------------------------------------------------------------------------- optimizer (optim.md)
NM_KNOB(optim, lr,          double,      0.02,       NM_HASH,  "-lr%g",     v >= 0, "MuonH and AdamH peak eta")
NM_KNOB(optim, adam_lr,     double,      0.008,      NM_HASH,  "-alr%g",    v >= 0, "Adam group peak")
NM_KNOB(optim, momentum,    double,      0.95,       NM_HASH,  "",          v >= 0 && v < 1, "MuonH Nesterov momentum mu (no (1-mu) factor)")
NM_KNOB(optim, beta1,       double,      0.9,        NM_HASH,  "",          v >= 0 && v < 1, "Adam/AdamH beta1")
NM_KNOB(optim, beta2,       double,      0.98,       NM_HASH,  "",          v >= 0 && v < 1, "Adam/AdamH beta2")
NM_KNOB(optim, eps,         double,      1e-20,      NM_HASH,  "",          v >= 0, "Adam/AdamH eps, outside the sqrt (groups may override: depth_adam 1e-8)")
NM_KNOB(optim, muon_eps,    double,      1e-5,       NM_HASH,  "",          v > 0, "NS input normalization eps, added to the norm")
NM_KNOB(optim, ns_steps,    int,         5,          NM_HASH,  "",          v >= 1 && v <= 16, "Newton-Schulz iterations")
NM_KNOB(optim, ns_coeffs,   std::string, "simple",   NM_HASH,  "",          one_of(v, {"simple","quintic","polar_express"}), "NS coefficient set; simple = (3.4445, -4.7750, 2.0315) every step")
NM_KNOB(optim, ns_precision, std::string, "auto",    NM_HASH,  "-ns%s",     one_of(v, {"auto","f32","3xtf32","tf32"}), "NS matmul precision; auto = T1.0 fact (TF32, or 3xTF32 if T1.6 holds, else f32)")
NM_KNOB(optim, max_grad_norm, double,    1.0,        NM_HASH,  "",          v > 0, "clip threshold, applied to each clip group's own norm")
NM_KNOB(optim, groups,      std::string, "",         NM_HASH | NM_CONTENT, "-grp",      true, "optional GroupSpec file (extra groups, eps/betas/lr tables, grad/update scales, post-update hooks); hashed by content")
NM_KNOB(optim, row_partition, std::string, "",       NM_HASH | NM_CONTENT, "-rp",       true, "optional RowPartition file (per-row freeze / lr / norm blocks for Adam and AdamH); hashed by content")
NM_KNOB(optim, schedule,    std::string, "linear",   NM_HASH,  "",          one_of(v, {"linear","cosine"}), "130m: constant then linear to 0; others: warmup then cosine to 0")
NM_KNOB(optim, warmup,      int,         0,          NM_HASH,  "",          v >= 0, "warmup steps")
NM_KNOB(optim, decay,       double,      0.8,        NM_HASH,  "",          v >= -1, "decay length: <=1 fraction of N (int(x*N)), >1 steps, -1 = N - warmup")
NM_KNOB(optim, min_lr_ratio, double,     0.0,        NM_HASH,  "",          v >= 0 && v <= 1, "end value / peak")
NM_KNOB(optim, num_steps,   int,         4959,       NM_HASH,  "-n%d",      v >= 1, "updates N")
NM_KNOB(optim, schedule_fixture, std::string, "",    NM_HASH | NM_CONTENT, "",          true, "dir with f32 sched_main, sched_adam [N] and 1-b1^t, 1-b2^t from jitted optax (tests/s2/schedule_fixture.py); required for parity runs")
NM_KNOB(optim, weight_decay, double,     0.0,        NM_HASH,  "-wd%g",     v >= 0, "decoupled weight decay actually applied; > 0 with a muonh_qwen3 preset requires optim.wd_variant")
NM_KNOB(optim, wd_variant,  bool,        false,      NM_HASH,  "-wdv",      true, "acknowledges a weight-decay variant (levanter logs 0.1 but the baseline applies none)")
NM_KNOB(optim, zero1,       std::string, "auto",     NM_HASH,  "",          one_of(v, {"auto","on","off"}), "ZeRO-1 ownership for every optimizer group (DESIGN.md §6.1); off = replicated optimizer")
NM_KNOB(optim, zero2_vocab, std::string, "auto",     NM_HASH,  "",          one_of(v, {"auto","on","off"}), "ZeRO-2 for vocab-sized gradients (reduce-scatter after every microbatch); not implemented yet: auto resolves to off, on is refused")

// ---------------------------------------------------------------------------------------------------- data (data.md)
NM_KNOB(data, dataset,      std::string, "fineweb-edu-10B-marin128k", NM_HASH | NM_CONTENT, "", true, "converted token set under $NM_DATA (its meta.json sha256 is hashed)")
NM_KNOB(data, data_seed,    int,         42,         NM_HASH,  "-ds%d",     v >= 0, "levanter data_seed: mixture block shuffle + LCG permutation")
NM_KNOB(data, global_batch, int,         128,        NM_HASH,  "-b%d",      v >= 1 && v <= (1 << 20), "sequences per update B (phases of data.plan may change it)")
NM_KNOB(data, mix_block,    int,         2048,       NM_HASH,  "",          v >= 1, "levanter mixture block size")
NM_KNOB(data, plan,         std::string, "",         NM_HASH | NM_CONTENT, "-dp%s",     true, "optional phase file (repeats with real-valued passes, reshuffles, per-phase batch / seq_len, explicit ids); hashed by content")
NM_KNOB(data, prefetch_steps, int,       256,        NM_LOCAL, "",          v >= 4, "depth of the pageable prefetch ring in steps (separate from launch lookahead 2)")
NM_KNOB(data, reader_threads, int,       16,         NM_LOCAL, "",          v >= 1 && v <= 64, "reader threads filling the prefetch ring")

// ---------------------------------------------------------------------------------------------------- eval (eval.md)
NM_KNOB(eval, paloma,       std::string, "paloma-marin128k", NM_HASH | NM_CONTENT, "",  true, "converted Paloma val set under $NM_DATA (its meta.json sha256 is hashed)")
NM_KNOB(eval, extra_sources, std::string, "",        NM_HASH | NM_CONTENT, "",          true, "extra EvalSources (DataPlan slices, sequence-id lists) with groupings; hashed by content")
NM_KNOB(eval, every,        int,         1000,       NM_HASH,  "",          v >= 0, "eval after update s when s % every == 0, s > 0 (logged at s; levanter off-by-one); 0 = final only")
NM_KNOB(eval, batch,        int,         128,        NM_HASH,  "",          v >= 1 && v <= (1 << 20), "estimator batch in sequences, independent of the GPU count (the bpb estimator depends on it)")
NM_KNOB(eval, micro_batches, int,        0,          NM_HASH,  "",          v >= 0, "estimator batches per eval microbatch; 0 = largest that fits")
NM_KNOB(eval, init_eval,    bool,        true,       NM_HASH,  "",          true, "evaluate before update 0 (gate a3), logged under eval_init/")
NM_KNOB(eval, exact_bpb,    bool,        true,       NM_HASH,  "",          true, "also log eval_exact/* (and eval_exact_shared/* across tokenizers)")
NM_KNOB(eval, per_position, bool,        false,      NM_LOCAL, "",          true, "dump per-position f32 losses of every eval to the run dir")
NM_KNOB(eval, ema_beta,     double,      0.0,        NM_HASH,  "-ema%g",    v >= 0 && v < 1, "also evaluate an EMA of the weights (eval/ema/*)")

// ---------------------------------------------------------------------------------------------------- execution
NM_KNOB(exec, gpus,         int,         4,          NM_HASH,  "",          v >= 1 && v <= 8, "data-parallel ranks on this node (recorded in the W&B config and tags)")
NM_KNOB(exec, micro_seqs,   int,         0,          NM_HASH,  "",          v >= 0, "sequences per GPU per microbatch; 0 = planner choice")
NM_KNOB(exec, remat,        std::string, "auto",     NM_HASH,  "",          one_of(v, {"auto","all","min","layer"}), "activation policy (core.hpp Remat)")
NM_KNOB(exec, policy,       std::string, "bf16",     NM_HASH,  "-%s",       one_of(v, {"bf16","f32"}), "compute policy; f32 = parity tests and gate V1 only (eager)")
NM_KNOB(exec, rounding,     std::string, "levanter", NM_HASH,  "-%s",       one_of(v, {"levanter","accurate"}), "rounding mode of every kernel (core.hpp Rounding)")
NM_KNOB(exec, attention,    std::string, "fa3",      NM_HASH,  "-attn%s",   one_of(v, {"fa3","cudnn","levref","ref_f32"}), "attention backend (kernels/attention.hpp)")
NM_KNOB(exec, attn_bwd_sched, std::string, "auto",   NM_HASH,  "",          one_of(v, {"auto","persistent","doc_causal"}), "FA3 backward scheduler; auto = the E1b decision (O1)")
NM_KNOB(exec, ce,           std::string, "auto",     NM_HASH,  "-ce%s",     one_of(v, {"auto","a","b1","b1_5","b2"}), "fused linear CE stage; auto = the E2 decision per D (O2)")
NM_KNOB(exec, ce_logits,    std::string, "auto",     NM_HASH,  "-cel%s",    one_of(v, {"auto","bf16","f32"}), "CE logits store dtype; auto = T1.0 item 2 fact (refuses to resolve in parity runs before T1.0)")
NM_KNOB(exec, ce_chunk_rows, int,        0,          NM_HASH,  "",          v == 0 || (v >= 128 && v % 128 == 0), "rows per CE chunk; 0 = rule of DESIGN.md 3.8")
NM_KNOB(exec, ce_dw_round,  std::string, "none",     NM_HASH,  "",          one_of(v, {"none","chunk"}), "chunk: levanter's bf16 head-gradient rounding per chunk and per microbatch (strict)")
NM_KNOB(exec, embed_accum,  std::string, "f32",      NM_HASH,  "",          one_of(v, {"f32","bf16_seq"}), "embedding backward accumulator; bf16_seq = levanter's precision, sorted order (strict)")
NM_KNOB(exec, grad_reduce,  std::string, "f32",      NM_HASH,  "-gr%s",     one_of(v, {"f32","bf16"}), "dtype of the gradient reduction (strict: bf16)")
NM_KNOB(exec, fused,        bool,        true,       NM_HASH,  "",          true, "stage-1 epilogue fusions; false = the unfused reference path (bitwise equal in levanter mode)")
NM_KNOB(exec, deterministic, bool,       true,       NM_HASH,  "",          true, "bitwise-repeatable step (DESIGN.md §11)")
NM_KNOB(exec, cuda_graph,   bool,        true,       NM_LOCAL, "",          true, "capture each step regime as one CUDA graph (off: eager, for --profile-ops and the f32 policy)")
NM_KNOB(exec, mem_budget_gib, double,    72.0,       NM_LOCAL, "",          v > 1 && v < 79.5, "arena budget per GPU")
NM_KNOB(exec, debug_arena,  std::string, "off",      NM_LOCAL, "",          one_of(v, {"off","canary","poison"}), "arena guard bands / NaN poison of transients (tests and new variants)")

// ---------------------------------------------------------------------------------------------------- run (identity and I/O)
NM_KNOB(run, parity,        bool,        false,      NM_HASH,  "",          true, "parity run (T2-T6): requires optim.schedule_fixture, the T1.0 facts file and a verified init (validate())")
NM_KNOB(run, parent,      std::string, "",         NM_HASH,  "-fork",     true, "fork: <run_id>@<step>; loads that checkpoint, verifies it against the parent's manifest, continues the data cursor")
NM_KNOB(run, root,          std::string, "$NM_RUNS", NM_LOCAL, "",          true, "directory that holds run directories")
NM_KNOB(run, label,         std::string, "",         NM_LOCAL, "",          true, "human name; empty = derived from size, gpus and tags")
NM_KNOB(run, wandb_entity,  std::string, "reself",   NM_LOCAL, "",          true, "W&B mirror entity (sidecar only)")
NM_KNOB(run, wandb_project, std::string, "marin-della", NM_LOCAL, "",       true, "W&B mirror project (sidecar only)")
NM_KNOB(run, wandb_name,    std::string, "",         NM_LOCAL, "",          true, "W&B run name; empty = muonh-qwen3-<size>-della4xh100-nm<tags>")
NM_KNOB(run, ckpt_every_min, int,        30,         NM_LOCAL, "",          v >= 1, "periodic checkpoint interval (async)")
NM_KNOB(run, keep_ckpts,    int,         2,          NM_LOCAL, "",          v >= 1, "rolling checkpoints kept")
NM_KNOB(run, keep_every,    int,         0,          NM_LOCAL, "",          v >= 0, "also keep every k-th step checkpoint forever (fork points); 0 = none")
NM_KNOB(run, keep_pass_boundaries, bool, true,       NM_LOCAL, "",          true, "keep a checkpoint at every data-pass boundary of the plan (fork points)")
NM_KNOB(run, metrics_flush, int,         32,         NM_LOCAL, "",          v >= 1, "steps between device-ring copies to the host (no host sync); forced before every eval row")
NM_KNOB(run, health_probe,  bool,        true,       NM_LOCAL, "",          true, "10 s GEMM + all-reduce probe at start; exit 99 below half the expected rate")
