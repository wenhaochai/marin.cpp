# Script mode (cmake -DNM_SRC=<repo> -DNM_OUT=<header> -P GitSha.cmake): writes `#define NM_GIT_SHA "<sha>[+dirty]"`
# to NM_OUT when the text differs from what is there (an unchanged sha recompiles nothing). See GitVersion.cmake.
execute_process(COMMAND git -C ${NM_SRC} rev-parse --short=12 HEAD
                OUTPUT_VARIABLE sha OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE rc)
if(NOT rc EQUAL 0 OR sha STREQUAL "")
  set(sha "unknown")
else()
  execute_process(COMMAND git -C ${NM_SRC} status --porcelain --untracked-files=no
                  OUTPUT_VARIABLE tracked OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  execute_process(COMMAND git -C ${NM_SRC} ls-files --others --exclude-standard -- src include cmake CMakeLists.txt
                  OUTPUT_VARIABLE untracked OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  if(NOT tracked STREQUAL "" OR NOT untracked STREQUAL "")
    string(APPEND sha "+dirty")
  endif()
endif()
set(text "// generated by cmake/GitSha.cmake\n#pragma once\n#define NM_GIT_SHA \"${sha}\"\n")
set(old "")
if(EXISTS ${NM_OUT})
  file(READ ${NM_OUT} old)
endif()
if(NOT old STREQUAL text)
  file(WRITE ${NM_OUT} "${text}")
endif()
